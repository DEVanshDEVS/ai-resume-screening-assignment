# Optional GitHub API authentication for higher rate limits.
GITHUB_TOKEN=

# Required only when running with --use-llm; leave unset to use deterministic scoring.
LLM_API_KEY=
LLM_MODEL=
# Optional OpenAI-compatible Chat Completions endpoint (default is OpenAI).
LLM_BASE_URL=https://api.openai.com/v1/chat/completions

